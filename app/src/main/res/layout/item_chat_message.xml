<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- ─── USER MESSAGE (right-aligned) ─── -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:background="@drawable/bg_chat_user_bubble"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/chat_user_text"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            tools:text="Tổng doanh thu tháng này là bao nhiêu?" />

    </LinearLayout>

    <!-- ─── BOT MESSAGE (left-aligned) ─── -->
    <LinearLayout
        android:id="@+id/layoutAiMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Bot avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="50dp"
            app:cardBackgroundColor="@color/primary_container"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Bot bubble (rich Markdown + Tables container) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layoutAiBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_bot_bubble"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/layoutAiMarkdownBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnCopyAiMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="📋 Sao chép"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
